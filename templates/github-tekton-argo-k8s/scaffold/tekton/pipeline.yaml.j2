# The project's CI, started by the Triggers installed in `proj-{{ project.slug }}-ci`.
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  generateName: {{ project.slug }}-ci-
spec:
  pipelineRef: { name: choregos-ci }
  params:
    - { name: repo-url, value: "{{ project.delivery.repo.url }}" }
    - { name: revision, value: "{{ project.delivery.repo.default_branch }}" }
    - { name: language, value: "{{ project.delivery.repo.language or 'python' }}" }
    - { name: image, value: "ghcr.io/{{ inputs.repo }}:latest" }
  workspaces:
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes: [ReadWriteOnce]
          resources: { requests: { storage: 5Gi } }
